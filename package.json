{
  "name": "scout-deployer",
  "version": "1.0.0",
  "description": "Deploy Microsoft Scout to Windows cluster nodes. Provisions binary, skills, connectors, MCP tools, permissions, memory, extensions, session history, and automations via PuTTY/SSH.",
  "keywords": [
    "microsoft-scout",
    "scout-deployer",
    "windows-cluster",
    "ssh-deployment"
  ],
  "author": "ScoutDeployer contributors",
  "license": "MIT",
  "private": true,
  "bin": {
    "scout-deployer":  "./bin/scout-deployer.js",
    "scout-skills":    "./bin/skills-server.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": ["win32"],
  "files": [
    "bin/scout-deployer.js",
    "bin/skills-server.js",
    "ScoutDeployer.ps1",
    "ScoutDeployer.cmd",
    "connectors/",
    "mcp-manifests/",
    "automations/",
    "extensions.txt",
    "README.md"
  ],
  "scripts": {
    "start":          "node bin/scout-deployer.js",
    "skills-server":  "node bin/skills-server.js",
    "lint":           "node --check bin/scout-deployer.js && node --check bin/skills-server.js",
    "syntax":         "powershell -NoProfile -Command \"$e=$null;$null=[System.Management.Automation.Language.Parser]::ParseFile('ScoutDeployer.ps1',[ref]$null,[ref]$e);if($e.Count -eq 0){'SYNTAX OK'}else{$e|%{$_.Message}}\"",
    "test:mcp":       "node -e \"const {spawnSync}=require('child_process');const r=spawnSync('node',['bin/skills-server.js'],{input:JSON.stringify({jsonrpc:'2.0',id:1,method:'tools/list',params:{}})+`\\n`,encoding:'utf8'});console.log(r.stdout)\""
  }
}
