# ScoutDeployer Environment Configuration Template
# Copy this file to .env and customize for your tenant

# ===== Tenant Configuration =====
# Microsoft Entra tenant information
SCOUT_TENANT_NAME=Contoso
SCOUT_TENANT_ID=00000000-0000-0000-0000-000000000000
SCOUT_DOMAIN=contoso.com
SCOUT_DOMAIN_ALT=contoso.example

# ===== Licensed User =====
# User account with Microsoft 365 Copilot license
SCOUT_LICENSED_USER=darbot@contoso.example

# ===== App Registration =====
# Entra App Registration for Scout/ClippyClaw integration
SCOUT_APP_REG_ID=11111111-1111-1111-1111-111111111111
SCOUT_APP_NAME=ClippyClaw

# ===== Fleet Configuration =====
# Friendly name for this deployment (used in logs and documentation)
SCOUT_SYSTEM_NAME=Contoso Scout Cluster

# Primary deployment node (IP or hostname)
SCOUT_PRIMARY_NODE_IP=scout-primary.contoso.com
SCOUT_PRIMARY_NODE_NAME=scout-primary

# Additional cluster nodes (comma-separated IPs)
SCOUT_ADDITIONAL_NODES=scout-gateway.contoso.com,scout-secondary.contoso.com

# ===== Deployment Credentials =====
# Target machine username (must be local admin)
SCOUT_TARGET_USER=administrator

# SSH key path for remote access
SCOUT_SSH_KEY_PATH=%USERPROFILE%\.ssh\id_ed25519_shared

# ===== Scout Binary Configuration =====
# Scout installer version and path
SCOUT_VERSION=0.22.333
SCOUT_INSTALLER_PATH=%USERPROFILE%\Downloads\MicrosoftScout-Windows-0.22.333-x64-Setup.exe

# ===== PuTTY Configuration =====
PUTTY_DIR=C:\Program Files\PuTTY

# ===== Local Source Paths =====
# Paths to local provisioning assets
LOCAL_SKILLS_ROOT=%USERPROFILE%\.copilot\skills
LOCAL_MEMORY_ROOT=%USERPROFILE%\.copilot\memory
LOCAL_SESSION_ROOT=%USERPROFILE%\.copilot\session-state
LOCAL_CONNECTORS_ROOT=
LOCAL_MCP_MANIFESTS_ROOT=
LOCAL_AUTOMATIONS_ROOT=
LOCAL_EXTENSIONS_LIST=

# ===== Logging =====
LOG_DIR=
